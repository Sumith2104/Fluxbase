# ═══════════════════════════════════════════════════════════════════════════════
# FLUXBASE PRODUCTION ENVIRONMENT CONFIGURATION (AWS EC2 / DOCKER)
# Domain: https://fluxbasedb.me
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ─── Domain & URLs ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://fluxbasedb.me
NEXT_PUBLIC_WS_URL=wss://fluxbasedb.me/ws
NEXT_PUBLIC_COOKIE_DOMAIN=.fluxbasedb.me

# ─── Authentication & Security ────────────────────────────────────────────────
# Generate a strong 64-character secret: openssl rand -base64 48
JWT_SECRET=your_high_entropy_production_jwt_secret_do_not_use_default

# ─── AWS RDS PostgreSQL (Database Engine) ─────────────────────────────────────
# Point to your AWS RDS PostgreSQL instance in Mumbai (ap-south-1)
AWS_RDS_POSTGRES_URL=postgresql://postgres:YOUR_PASSWORD@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/fluxbase_global?sslmode=require

# ─── Redis Cache & Rate Limiter ───────────────────────────────────────────────
# Local Docker Redis container inside the compose network (sub-millisecond latency):
REDIS_URL=redis://redis:6379

# Upstash Redis REST compatibility (if using Upstash or leave configured):
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ─── AWS S3 Storage v2 ────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=fluxbase-s3

# ─── Flux AI Multimodal Gateway ─────────────────────────────────────────────
GLM_API_KEY=your_zhipu_glm_api_key_for_flux_model_family
GEMINI_API_KEY=your_google_gemini_api_key_for_vision_imagen_embeddings
GROQ_API_KEY=your_groq_api_key_for_whisper_stt_and_llama
OPENAI_API_KEY=your_openai_api_key_for_dalle_and_tts

# ─── AI Generated Media Storage ─────────────────────────────────────────────
AI_MEDIA_S3_PREFIX=ai-media
AI_MEDIA_RETENTION_DAYS_FREE=1
AI_MEDIA_RETENTION_DAYS_PAID=30

# ─── Realtime WebSocket Server ───────────────────────────────────────────────
WS_PORT=4000
