# Production Domain with Automatic SSL
fluxbasedb.me, www.fluxbasedb.me {
    # Canonical redirection: www.fluxbasedb.me -> fluxbasedb.me
    @www host www.fluxbasedb.me
    redir @www https://fluxbasedb.me{uri} permanent

    # Google Search Console Verification
    @googleVerification {
        path /googleae107909e1a27d85.html
    }
    handle @googleVerification {
        header Content-Type "text/html; charset=utf-8"
        respond "google-site-verification: googleae107909e1a27d85.html" 200
    }

    # Real-Time WebSocket connections (ONLY /ws* routes to standalone WS server)
    @websockets {
        path /ws*
    }
    handle @websockets {
        reverse_proxy websocket:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Static Assets Caching (Next.js immutable hashed assets)
    @static {
        path /_next/static/* /monaco-editor/* /favicon.ico /logo.png
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # High-speed streaming routes (AI chat & realtime SSE)
    @streaming {
        path /api/ai-chat* /api/ai/* /api/v1/chat/* /api/realtime/subscribe* /api/chat/*
    }
    handle @streaming {
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
        }
    }

    # Next.js Application, REST SQL Engine, Flux AI Gateway & MCP Gateway
    handle {
        encode zstd gzip

        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            lb_try_duration 30s
            lb_try_interval 250ms
        }
    }
}

# FluxPay Payment Gateway Subdomain with Automatic SSL
payments.fluxbasedb.me {
    encode zstd gzip

    # Static Assets Caching (Next.js immutable hashed assets)
    @static {
        path /_next/static/* /favicon.ico /logo.png
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy gateway:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # High-speed streaming routes (Order SSE stream)
    @streaming {
        path /api/v1/orders/*/stream
    }
    handle @streaming {
        reverse_proxy gateway:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
        }
    }

    handle {
        reverse_proxy gateway:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            lb_try_duration 30s
            lb_try_interval 250ms
        }
    }
}


# Fallback for Direct IP Access (for testing before DNS cutover)
:80 {
    @websockets {
        path /ws*
    }
    handle @websockets {
        reverse_proxy websocket:4000
    }

    @streaming {
        path /api/ai-chat* /api/ai/* /api/v1/chat/* /api/realtime/subscribe*
    }
    handle @streaming {
        reverse_proxy app:3000 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy app:3000 {
            lb_try_duration 30s
            lb_try_interval 250ms
        }
    }
}

